# Copy to .env (gitignored) and fill in. Never commit real values.

# LLM provider key (DeepSeek or OpenRouter)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Telegram bot (reports and approvals)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Foreign proxy used ONLY for LLM and Telegram traffic, never for hh.ru.
# Example: socks5://host:port (put credentials only in the real .env)
LLM_PROXY_URL=
TELEGRAM_PROXY_URL=

# Search for the outreach ("hidden market") discovery. Yandex Search API (Yandex Cloud): an API key of a service account
# with the role search-api.webSearch.user; the folder id is optional. Serper (google.serper.dev, Google results) is optional:
# with a key the bot searches both and merges the results; without one only Yandex is used.
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=
SERPER_API_KEY=

# Contacts shown as ready-to-copy answers for vacancies with a questionnaire (optional)
APPLY_PHONE=
APPLY_TELEGRAM=
APPLY_EMAIL=
